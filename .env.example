# Frontend (.env.local, and in Netlify: Site settings > Environment variables)
# Convex deployment URL; `npx convex dev` prints it.
VITE_CONVEX_URL=

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Backend keys are NOT set here. Set them on the Convex deployment:
#   npx convex env set NEBIUS_API_KEY ...
#   npx convex env set GITHUB_TOKEN ...      (optional)
#   npx convex env set TAVILY_API_KEY ...    (optional)
#   npx convex env set RUNNER_URL ...        (optional, enables sandbox execution)
#   npx convex env set RUNNER_TOKEN ...      (required with RUNNER_URL)
